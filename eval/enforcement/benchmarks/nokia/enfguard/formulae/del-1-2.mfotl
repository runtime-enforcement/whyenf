ALWAYS (
  FORALL user, data.
    delete(user, "db1", data) AND data <> "[unknown]"
    IMPLIES:R (
      (
        ONCE[0,1s) (
          EXISTS user2. delete(user2, "db2", data)
        )
        OR:R
        EVENTUALLY[0,30h) (
          EXISTS user2. delete(user2, "db2", data)
        )
      )   
      OR:L
      (
        (
          ONCE[0,30h) (
            EXISTS user2. insert(user2, "db1", data)
          )
        )
        AND
        (
          HISTORICALLY[0,30h) (
            NOT (EXISTS user2. delete(user2, "db3", data))
          )
        )
      )
    )
)