ALWAYS (
  FORALL user, data.
    insert(user, "db1", data) AND data <> "[unknown]"
    IMPLIES:R
    (
      ONCE[0,1s) (
        EXISTS user2. insert(user2, "db2", data) OR delete(user2, "db1", data)
      )
      OR:R
      EVENTUALLY[0,30h] (
        EXISTS user2. insert(user2, "db2", data) OR delete(user2, "db1", data)
      )
    )
)