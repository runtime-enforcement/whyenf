// Conjunction of the Dogwood policies (generated by make_all_dogwood.py).
// decide: SendMoney, Schedule, Redirect, Amend, UpdatePassword, UpdateUserInfo
// time-scale: 60

@id("sendmoney")
permit (principal, action == L::Action::"SendMoney", resource);
@id("schedule")
permit (principal, action == L::Action::"Schedule", resource);
@id("redirect")
permit (principal, action == L::Action::"Redirect", resource);
@id("amend")
permit (principal, action == L::Action::"Amend", resource);
@id("updatepassword")
permit (principal, action == L::Action::"UpdatePassword", resource);
@id("updateuserinfo")
permit (principal, action == L::Action::"UpdateUserInfo", resource);

// ── b1_payee_provenance ──
def temporal unknown_payee(?s, ?u, ?r) {
    !formerly within 36500d L::Action::"UserMentions"::state{ input.s: ?s, input.v: ?r }
    && !formerly within 36500d L::Action::"Paid"::state{ input.u: ?u, input.r: ?r }
    && !(exists (f: String). formerly within 36500d (
            L::Action::"FromDoc"::state{ input.s: ?s, input.f: f, input.v: ?r }
            && formerly within 36500d L::Action::"UserDoc"::state{ input.s: ?s, input.f: f }))
};

@id("b1_send")
forbid (principal, action == L::Action::"SendMoney", resource)
when temporal { unknown_payee(context.input.s, context.input.u, context.input.r) };
@id("b1_schedule")
forbid (principal, action == L::Action::"Schedule", resource)
when temporal { unknown_payee(context.input.s, context.input.u, context.input.r) };

// ── b2_no_leak_in_subject ──
def temporal leaks(?c, ?s) {
    exists (t: String). (
        formerly within 36500d L::Action::"SubjTok"::state{ input.c: ?c, input.t: t }
        && formerly within 36500d L::Action::"Trusted"::state{ input.s: ?s, input.v: t }
        && !formerly within 36500d L::Action::"UserMentions"::state{ input.s: ?s, input.v: t }
        && !(exists (f: String). formerly within 36500d (
                L::Action::"FromDoc"::state{ input.s: ?s, input.f: f, input.v: t }
                && formerly within 36500d L::Action::"UserDoc"::state{ input.s: ?s, input.f: f }))
    )
};

@id("b2_send")
forbid (principal, action == L::Action::"SendMoney", resource)
when temporal { leaks(context.input.c, context.input.s) };
@id("b2_schedule")
forbid (principal, action == L::Action::"Schedule", resource)
when temporal { leaks(context.input.c, context.input.s) };

// ── b3_daily_cap ──
@id("b3")
forbid (principal, action == L::Action::"SendMoney", resource)
when temporal {
    exists (t: Long). (
        (sum a for (a: Long), (rid: String). where (
            formerly within 24h L::Action::"SendMoney"::request{
                input.u: context.input.u, input.r: context.input.r, input.a: a, rid: rid }
            && !formerly within 24h L::Action::"SendMoney"::denied{ rid: rid }
        )) == t
        && t > 1000000
    )
};

// ── b4_velocity ──
@id("b4")
forbid (principal, action == L::Action::"SendMoney", resource)
when temporal {
    exists (n: Long). (
        (count for (rid: String). where (
            formerly within 1h L::Action::"SendMoney"::request{ input.u: context.input.u, rid: rid }
            && !formerly within 1h L::Action::"SendMoney"::denied{ rid: rid }
        )) == n
        && n > 2
    )
};

// ── b5_redirect ──
@id("b5")
forbid (principal, action == L::Action::"Redirect", resource)
when temporal {
    !formerly within 36500d L::Action::"UserMentions"::state{
        input.s: context.input.s, input.v: context.input.r }
};

// ── b6_password ──
@id("b6")
forbid (principal, action == L::Action::"UpdatePassword", resource)
when temporal {
    !formerly within 36500d L::Action::"UserMentions"::state{
        input.s: context.input.s, input.v: context.input.p }
};

// ── b7_cooldown ──
def temporal unknown(?u, ?r) {
    !formerly within 36500d L::Action::"Paid"::state{ input.u: ?u, input.r: ?r }
    && !(exists (rid: String). (
            previous within 36500d (formerly within 36500d
                L::Action::"SendMoney"::request{ input.u: ?u, input.r: ?r, rid: rid })
            && !formerly within 36500d L::Action::"SendMoney"::denied{ rid: rid }))
};

@id("b7_info")
forbid (principal, action == L::Action::"SendMoney", resource)
when temporal {
    exists (rid: String). (formerly within 24h L::Action::"UpdateUserInfo"::request{ input.u: context.input.u, rid: rid }
        && !formerly within 24h L::Action::"UpdateUserInfo"::denied{ rid: rid })
    && unknown(context.input.u, context.input.r)
};
@id("b7_password")
forbid (principal, action == L::Action::"SendMoney", resource)
when temporal {
    exists (rid: String). (formerly within 24h L::Action::"UpdatePassword"::request{ input.u: context.input.u, rid: rid }
        && !formerly within 24h L::Action::"UpdatePassword"::denied{ rid: rid })
    && unknown(context.input.u, context.input.r)
};

// ── b8_quarantine ──
@id("b8_send")
forbid (principal, action == L::Action::"SendMoney", resource)
when temporal { formerly within 1h L::Action::"Blocked"::state{ input.s: context.input.s } };
@id("b8_schedule")
forbid (principal, action == L::Action::"Schedule", resource)
when temporal { formerly within 1h L::Action::"Blocked"::state{ input.s: context.input.s } };
@id("b8_redirect")
forbid (principal, action == L::Action::"Redirect", resource)
when temporal { formerly within 1h L::Action::"Blocked"::state{ input.s: context.input.s } };
@id("b8_amend")
forbid (principal, action == L::Action::"Amend", resource)
when temporal { formerly within 1h L::Action::"Blocked"::state{ input.s: context.input.s } };
@id("b8_password")
forbid (principal, action == L::Action::"UpdatePassword", resource)
when temporal { formerly within 1h L::Action::"Blocked"::state{ input.s: context.input.s } };
@id("b8_info")
forbid (principal, action == L::Action::"UpdateUserInfo", resource)
when temporal { formerly within 1h L::Action::"Blocked"::state{ input.s: context.input.s } };

// ── b10_invoice ──
@id("b10")
forbid (principal, action == L::Action::"SendMoney", resource)
when temporal {
    !formerly within 36500d L::Action::"UserMentions"::state{ input.s: context.input.s, input.v: context.input.r }
    && !formerly within 36500d L::Action::"Paid"::state{ input.u: context.input.u, input.r: context.input.r }
    && !(exists (rid: String). (
            previous within 36500d (formerly within 36500d
                L::Action::"SendMoney"::request{ input.u: context.input.u, input.r: context.input.r, rid: rid })
            && !formerly within 36500d L::Action::"SendMoney"::denied{ rid: rid }))
    && !(exists (f: String). (
            formerly within 36500d (
                L::Action::"FromDoc"::state{ input.s: context.input.s, input.f: f, input.v: context.input.r }
                && formerly within 36500d L::Action::"UserDoc"::state{ input.s: context.input.s, input.f: f })
            && formerly within 36500d L::Action::"DocAmount"::state{
                input.s: context.input.s, input.f: f, input.a: context.input.a }))
};
