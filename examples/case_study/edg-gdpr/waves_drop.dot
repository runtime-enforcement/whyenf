digraph waves {
  rankdir=TB;
  compound=true;
  node [shape=box, style="filled,rounded", fontsize=10];
  edge [color="#555555", arrowsize=0.6];

  subgraph cluster_legend {
    label="Legend"; rank=sink;
    style=dashed; fontsize=9; color="#aaaaaa"; bgcolor="white";
    lfix  [label="fixpoint (sequential)", fillcolor="#ff9999"];
    lonce [label="once (sequential)",     fillcolor="#cfe8ff"];
    lfix -> lonce [style=invis];
  }

  subgraph cluster_w0 {
    label="Wave 0";
    style=rounded; color="#999999"; bgcolor="#f8f8ff";
    s0 [label="Sup_Exists3\nonce  (4 rules)", fillcolor="#cfe8ff"];
  }
  subgraph cluster_w1 {
    label="Wave 1";
    style=rounded; color="#999999"; bgcolor="#f8f8ff";
    s1 [label="inform\nonce  (4 rules)", fillcolor="#cfe8ff"];
  }
  subgraph cluster_w2 {
    label="Wave 2";
    style=rounded; color="#999999"; bgcolor="#f8f8ff";
    s2 [label="notify_proc\nonce  (3 rules)", fillcolor="#cfe8ff"];
  }
  subgraph cluster_w3 {
    label="Wave 3";
    style=rounded; color="#999999"; bgcolor="#f8f8ff";
    s3 [label="use\nonce  (2 rules)", fillcolor="#cfe8ff"];
  }
  s0 -> s1;
  s1 -> s2;
  s2 -> s3;
}
