event consent(int, str);
event delete(str, str, int);
event deletion_request(str, str, int);
event legal_ground(int, str);
event use(str, str, int);
event Sup_Exists2(str, str);
event Sup_Exists3(str);
event Sup_Exists4();

fun add(x:int, y:int) : int {
    return x + y
}
fun conc(x:str, y:str) : str {
    return x + y
}
fun div(x:int, y:int) : int {
    return x // y
}
fun eq(x:int, y:int) : int {
    return 1 if x == y else 0
}
fun fadd(x:float, y:float) : float {
    return x + y
}
fun fdiv(x:float, y:float) : float {
    return x / y
}
fun float_of_int(x:int) : float {
    return float(x)
}
fun fmul(x:float, y:float) : float {
    return x * y
}
fun fpow(x:float, y:float) : float {
    return x ** y
}
fun fsub(x:float, y:float) : float {
    return x - y
}
fun geq(x:int, y:int) : int {
    return 1 if x >= y else 0
}
fun gt(x:int, y:int) : int {
    return 1 if x > y else 0
}
fun int_of_float(x:float) : int {
    return int(x)
}
fun leq(x:int, y:int) : int {
    return 1 if x <= y else 0
}
fun lt(x:int, y:int) : int {
    return 1 if x < y else 0
}
fun match(x:str, r:str) : int {
    import re
    return 1 if re.match(r, x) else 0
}
fun mul(x:int, y:int) : int {
    return x * y
}
fun neq(x:int, y:int) : int {
    return 1 if x != y else 0
}
fun not(x:int) : int {
    return 0 if x else 1
}
fun pow(x:int, y:int) : int {
    return x ** y
}
fun string_of_float(x:float) : str {
    return str(x)
}
fun string_of_int(x:int) : str {
    return str(x)
}
fun sub(x:int, y:int) : int {
    return x - y
}
fun substr(x:str, start:int, end:int) : str {
    return x[start:end]
}
fun ufsub(x:float) : float {
    return -x
}
fun usub(x:int) : int {
    return -x
}

let Exists2(c:str, d:str) := {
  !(((!use(c, d, u) | Once1(c, u)) | (!use(c, d, u) | Once0(d, u))))
}

filter let Exists3(c:str) := {
  !(!Exists2(c, d))
}

filter let Exists4() := {
  !(!Exists3(c))
}

table Once1(c:str, u:int) :=
  add {
    consent(u, c)
  };

table Once0(d:str, u:int) :=
  add {
    legal_ground(u, d)
  };

rule +Sup_Exists4() :=
  trigger {
    if Exists4()
  };

rule +Sup_Exists3(c) :=
  trigger {
    Sup_Exists4()
      if Exists3(c)
  };

rule +Sup_Exists2(c, d) :=
  trigger {
    Sup_Exists3(c)
      if Exists2(c, d)
  };

rule -use(c, d, u) :=
  trigger {
    Sup_Exists2(c, d) & use(c, d, u)
      if !Once1(c, u) & ((!use(c, d, u) | Once0(d, u)))
  };

