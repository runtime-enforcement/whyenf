LET DataProcessing(_p172 : string, _p173 : string, _p174 : string, _p175 : string)- = ∃ds. ∃ds'. ∃p. (Read(_p175, ds, _p174, p, ds')) ∧:L ((_p173) = "Minitwit, Inc.") ∧:L ((_p172) = "Minitwit, Inc.") IN
LET HasStorageCriteria(_p145 : string, _p146 : string) = _p146 = "Data is stored until the user deletes their account" IN 
LET IsStorageCriteria(_p88 : string, _p89 : string)+ = HasText(_p88, "The condition under which we keep your data is: " ^ string_of_criteria(_p89)) IN
 □[0s,∞) ∀c. ∀d. (∃a. ∃pr. DataProcessing(pr, c, a, d)) →:R (∃re. ∀cr. HasStorageCriteria(d, cr) →:R IsStorageCriteria(re, cr))

