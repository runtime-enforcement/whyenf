use crate::ast::*;

grammar;

match {
    r"\s*" => {},  // skip whitespace
    _,
}

// ─── Top level ───────────────────────────────────────────────────────────────

pub Log: Vec<TimePoint> = {
    <tps:TimePointEntry*> => tps,
};

pub SingleTimePoint: TimePoint = {
    <t:TimePointEntry> => t,
};

TimePointEntry: TimePoint = {
    "@" <ts:Num> <evts:Event*> ";" => TimePoint {
        timestamp: ts as u64,
        events: evts,
    },
};

Event: EventInstance = {
    <name:Ident> "(" <args:Comma<Val>> ")" => EventInstance {
        name: name.to_string(),
        args,
    },
};

// ─── Values ──────────────────────────────────────────────────────────────────

Val: Value = {
    <n:Num> => Value::Int(n),
    <f:Float> => Value::Float(OrderedFloat(f)),
    <s:StrLit> => Value::Str(crate::ast::intern(&s)),
    "true" => Value::Bool(true),
    "false" => Value::Bool(false),
    // Bare (unquoted) string atoms, MonPoly-style: e.g. subnet/node ids like
    // `lkr47-pyu6b-...-qae` or hex hashes like `1b34671991e24e4f...`.
    <s:Ident> => Value::Str(crate::ast::intern(&s)),
};

// ─── Helpers ─────────────────────────────────────────────────────────────────

Comma<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => { v.push(e); v }
    }
};

// ─── Terminals ───────────────────────────────────────────────────────────────

// Identifiers double as event names and as bare (unquoted) string atoms.
// The pattern allows leading digits (hex hashes like `1b34...`) and embedded
// hyphens (principal/subnet ids), but requires at least one letter/underscore
// so that pure integers and floats are still lexed as numbers.
Ident: String = {
    r"[0-9]*[A-Za-z_][0-9A-Za-z_-]*" => <>.to_string(),
};

Num: i64 = {
    r"-?[0-9]+" => <>.parse().unwrap(),
};

Float: f64 = {
    r"-?[0-9]+\.[0-9]+" => <>.parse().unwrap(),
};

StrLit: String = {
    // Allow backslash escapes inside string literals (e.g. `\"` for an embedded
    // quote, `\\` for a backslash), as produced by the IC logs.
    r#""(\\.|[^"\\])*""# => {
        let s = <>;
        let inner = &s[1..s.len()-1];
        let mut out = String::with_capacity(inner.len());
        let mut chars = inner.chars();
        while let Some(c) = chars.next() {
            if c == '\\' {
                if let Some(n) = chars.next() { out.push(n); }
            } else {
                out.push(c);
            }
        }
        out
    },
};
